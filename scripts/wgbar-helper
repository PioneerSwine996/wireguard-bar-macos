#!/bin/bash
# wgbar-helper: the only command WireGuardBar runs as root (through sudo).
# Installed root-owned at /Library/PrivilegedHelperTools/wgbar-helper by install-helper.sh.
set -euo pipefail
umask 077   # anything written here (temp configs) is root-only
export PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
CONF_DIR=/etc/wireguard   # root-owned, so a symlink swap can't redirect reads/writes
RUN_DIR=/var/run/wireguard
WG_QUICK=/Library/PrivilegedHelperTools/wgbar-wg-quick   # patched copy from install-helper.sh
OVERRIDE_DIR=/var/run/wgbar   # per-connection config copies with AllowedIPs overridden

die() { echo "$*" >&2; exit 1; }
name_ok() {
  [[ "${1:-}" =~ ^[a-zA-Z0-9_=+.-]{1,15}$ ]] || die "\"${1:-}\" can't be used as a tunnel name: wg-quick needs 1-15 letters, digits or _=+.- (no spaces or brackets). Rename it, e.g. sudo mv \"$CONF_DIR/${1:-}.conf\" $CONF_DIR/home2.conf"
}
conf() {
  name_ok "${1:-}"
  [ -f "$CONF_DIR/$1.conf" ] || die "no config named $1 in $CONF_DIR"
  echo "$CONF_DIR/$1.conf"
}

case "${1:-}" in
status)
  for f in "$CONF_DIR"/*.conf; do [ -e "$f" ] && printf 'config\t%s\n' "$(basename "$f" .conf)"; done
  for f in "$RUN_DIR"/*.name; do
    [ -e "$f" ] && printf 'tunnel\t%s\t%s\n' "$(basename "$f" .name)" "$(cat "$f")"
  done
  # Hide the interface private key (5-field lines) and peer preshared keys (9-field lines).
  wg show all dump | awk -F'\t' -v OFS='\t' 'NF==5{$2="(hidden)"} NF==9{$3="(hidden)"} {print}' ;;
up)
  # optional 3rd arg: AllowedIPs to use instead of the config's (route-all / split toggle)
  c=$(conf "${2:-}")
  if [ -n "${3:-}" ]; then
    re='^[0-9a-fA-F:./, ]+$'
    [[ "$3" =~ $re && ${#3} -le 512 ]] || die "invalid AllowedIPs: $3"
    mkdir -p "$OVERRIDE_DIR"
    r="$OVERRIDE_DIR/$2.conf"
    ALLOWED="$3" perl -pe 's/^\s*AllowedIPs\s*=.*$/AllowedIPs = $ENV{ALLOWED}/i' "$c" > "$r"
    c=$r
  fi
  "$WG_QUICK" up "$c" ;;
down)
  c=$(conf "${2:-}")
  r="$OVERRIDE_DIR/$2.conf"
  [ -f "$r" ] && c=$r
  "$WG_QUICK" down "$c"
  rm -f "$r" ;;
addresses)
  # Address/DNS lines only (never keys), for computing split-tunnel routes
  c=$(conf "${2:-}"); grep -iE '^[[:space:]]*(Address|DNS)[[:space:]]*=' "$c" || true ;;
read)
  c=$(conf "${2:-}"); cat "$c" ;;
write)
  c=$(conf "${2:-}")   # existing tunnels only
  tmp=$(mktemp "$CONF_DIR/.wgbar.XXXXXX"); trap 'rm -f "$tmp"' EXIT
  cat > "$tmp"; chmod 600 "$tmp"; mv "$tmp" "$c"; trap - EXIT ;;
import)
  name_ok "${2:-}"   # new tunnels only; never overwrites
  c="$CONF_DIR/$2.conf"
  [ ! -e "$c" ] || die "A tunnel named $2 already exists."
  tmp=$(mktemp "$CONF_DIR/.wgbar.XXXXXX"); trap 'rm -f "$tmp"' EXIT
  cat > "$tmp"; chmod 600 "$tmp"; mv -n "$tmp" "$c" ;;   # EXIT trap cleans up if mv -n refused
*)
  die "usage: wgbar-helper status | addresses NAME | import NAME | up NAME | down NAME | read NAME | write NAME" ;;
esac
